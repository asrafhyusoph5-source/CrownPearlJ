rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Certificates collection:
    // Anyone in the world can verify certificates (public verification portal)
    match /certificates/{certificateNumber} {
      allow get, list: if true;

      function isValidCertificate(data) {
        return data.certificateNumber is string && data.certificateNumber.size() > 0 && data.certificateNumber.size() <= 64 &&
               data.productId is string && data.productId.size() > 0 && data.productId.size() <= 64 &&
               data.productName is string && data.productName.size() > 0 && data.productName.size() <= 200 &&
               data.pearlType is string && data.pearlType.size() <= 100 &&
               data.pearlColor is string && data.pearlColor.size() <= 100 &&
               data.pearlSize is string && data.pearlSize.size() <= 100 &&
               data.metal is string && data.metal.size() <= 100 &&
               data.category is string && data.category.size() <= 100 &&
               data.issuedDate is string && data.issuedDate.size() <= 100 &&
               (data.status == 'verified' || data.status == 'revoked');
      }

      allow create, update: if isValidCertificate(request.resource.data);
      allow delete: if true;
    }

    // Products collection:
    // Anyone can read catalog items
    // Atelier managers can create, update, or delete inventory
    match /products/{productId} {
      allow get, list: if true;

      function isValidProduct(data) {
        return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.price is number && data.price >= 0;
      }

      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }
  }
}
